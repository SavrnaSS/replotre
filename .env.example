# Domain must point at your server (A/AAAA). Caddy provisions HTTPS.
DOMAIN=studio.example.com
# Protect signup on an early-access deployment; remove when ready to invite everyone.
SIGNUP_INVITE_CODE=change-this-to-a-long-random-string
ALLOW_SIGNUP=true
# Optional: enables speech timestamps, sampled-frame vision and AI Director.
# Local scene/audio analysis and explicit editing tools work without this key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
MAX_FILE_MB=300
USER_STORAGE_GB=2
MAX_USERS=1000
# Optional: Claude designs and fits creative templates (Templates panel → "Fit with Claude" / "Design with Claude").
# Templates still apply locally, grounded in your transcript and beats, without this key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Payments (Whop) ---
# Leave WHOP_API_KEY empty locally: plans then switch instantly in test mode and nothing is charged.
# API key: whop.com/dashboard/developer (needs checkout_configuration:create, member:basic:read, member:manage, membership:cancel).
WHOP_API_KEY=
# Webhook secret (starts with ws_). Webhook URL: https://YOUR_DOMAIN/api/billing/webhook
WHOP_WEBHOOK_SECRET=
# Your business id (biz_...). Optional when the API key belongs to one business.
WHOP_ACCOUNT_ID=
# Whop plan ids (plan_...) for each price.
WHOP_PLAN_CREATOR_MONTHLY=
WHOP_PLAN_CREATOR_YEARLY=
WHOP_PLAN_PRO_MONTHLY=
WHOP_PLAN_PRO_YEARLY=
# Sandbox testing: https://sandbox-api.whop.com/api/v1 (sandbox keys from sandbox.whop.com)
WHOP_API_BASE=https://api.whop.com/api/v1
