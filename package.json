{
  "name": "replotre-studio",
  "version": "2.1.0",
  "private": true,
  "description": "Replotre Studio: realtime, source-aware video editing with media analysis, speech captions, version history and MP4 rendering",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "dev": "node --env-file-if-exists=.env --watch server.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:seo": "node --test tests/seo.test.mjs",
    "seo:audit": "node scripts/audit-seo.mjs",
    "test:core": "node --test tests/director.test.mjs tests/pipeline.test.mjs tests/playback.test.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@anthropic-ai/sdk": "1.12.0"
  }
}
